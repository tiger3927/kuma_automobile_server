# 复制为 .env（服务器：/data/kuma_automobile_server/.env，chmod 600，不入 git）
# 凭据真值见 Debug.md；本文件只给键名与默认值

# ── 进程与端口（Task-Server.md §5）────────────────────────────────
KUMA_ENV=dev                      # dev|prod
KUMA_API_PORT=8100                # FastAPI HTTP+WS（绑 127.0.0.1，公网经 nginx）
KUMA_GATEWAY_HEALTH_PORT=8101
KUMA_WORKER_HEALTH_PORT=8102

# ── PostgreSQL（Task-DataBase.md §3 三角色）────────────────────────
# api / gateway / worker 一律用 kuma_app（只 DML）；迁移用 kuma_owner
KUMA_DSN=postgresql+asyncpg://kuma_app:CHANGE_ME@127.0.0.1:5432/kuma
KUMA_POOL_SIZE=5
KUMA_MAX_OVERFLOW=5
KUMA_POOL_TIMEOUT=5               # 连接获取超时（Task-DataBase.md §8）

# ── Redis（复用 orio-search-redis，DB5 + kuma: 前缀 + 强制 TTL）──────
KUMA_REDIS_URL=redis://127.0.0.1:6379/5
KUMA_REDIS_PREFIX=kuma:
KUMA_STATE_TTL=90                 # 车辆在线状态 TTL（秒）

# ── RabbitMQ ──────────────────────────────────────────────────────
KUMA_AMQP_URL=amqp://kuma_mq:CHANGE_ME@127.0.0.1:5672/%2Fkuma
KUMA_MQTT_URL=mqtt://127.0.0.1:1883        # gateway 侧订阅（本机明文；公网 8105 走 TLS）
KUMA_MQTT_USER=kuma_mq
KUMA_MQTT_PASSWORD=CHANGE_ME

# ── 鉴权 ──────────────────────────────────────────────────────────
KUMA_JWT_SECRET=CHANGE_ME_32B_RANDOM
KUMA_JWT_ALG=HS256
KUMA_ACCESS_TTL=900               # 15min
KUMA_REFRESH_TTL=2592000          # 30d

# ── 遥测管道（Task-Server.md §3/§12）───────────────────────────────
KUMA_TELE_BATCH_SIZE=500          # COPY 批量
KUMA_TELE_FLUSH_INTERVAL=1.0      # 秒
KUMA_TELE_QUEUE_MAX=20000         # 有界队列，满则丢低优先级 + 计数
KUMA_DEADBAND_MIN_DIST_M=15       # 静止/低速时位置变化小于此值不落原始点
KUMA_DEADBAND_MAX_SPEED=3.0       # km/h
KUMA_BACKFILL_MAX_HOURS=72        # 补报窗口上限，超期丢弃 + 计数

# ── 下行控制安全闸门（Task-Server.md §9）────────────────────────────
KUMA_CMD_MAX_RETRY=3
KUMA_CMD_TIMEOUT=20
KUMA_CMD_SPEED_LIMIT_KMH=5.0      # 行车中禁断电类指令

# ── 地图 Provider（Task-Server.md §10.2；无 key 则自动降级为直线距离）──
KUMA_GOOGLE_KEY=
KUMA_AMAP_KEY=
KUMA_MAPS_CACHE_TTL=3600
KUMA_MAPS_DAILY_QUOTA=20000
