[Unit]
Description=kuma mqtt gateway (single instance)
After=network-online.target docker.service kuma-postgres.service
Wants=docker.service

[Service]
Type=exec
User=tiger
Group=tiger
WorkingDirectory=/data/kuma_automobile_server
Environment=PATH=/data/tiger/miniconda3/envs/kuma/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/data/kuma_automobile_server/deploy/runtime.env
ExecStart=/data/tiger/miniconda3/envs/kuma/bin/python gateway.py
Restart=always
RestartSec=5
# 单实例保证：同一 ExecStart 只允许一个进程（重复订阅防护，Task-Server.md §12-7）
MemoryMax=300M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
